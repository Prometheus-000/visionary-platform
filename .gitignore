__pycache__/
*.pyc
.DS_Store
node_modules/
.next/
*.tsbuildinfo
.env.local

# Screenshots of other people's products, kept locally as design reference.
# Not ours to redistribute, which is what committing them to a public repo
# would do — so they stay on disk and out of the history.
screenshots for styling inspiration/

# Per-machine Claude Code settings. launch.json is committed because the
# preview server is a fact about the project; the permission list is not.
.claude/settings.local.json

# Scratch the author keeps in-tree
stuff to git ignore/

# Reference images for the prompt work — the Gucci recreations, the Krea 2
# examples published with the checkpoint, film stills. The *prompts* are in
# docs/krea2-prompt-template.md and tools/smoke_parse.py because they are the
# corpus everything is checked against; the pictures are other people's and
# stay out of the history for the same reason the styling screenshots do.
Prompt to generation examples/
*.jpeg
*.avif
Jack-Torrance-*.png
287092__97533.jpg

# Ideation artefacts and design handoffs — the master plan, the rejected
# prototypes, exported sessions. They informed what got built and none of them
# build anything. docs/ carries whatever survived.
master plan/
chip-based-prompt-mockup/
Design_System_Concept/
*-handoff.zip
session-export-*/

# The duplicate scanner's tuning corpus — 731 fashion-week photographs, ~520MB,
# plus the .thumbs/fingerprints.json a scan leaves behind in it. Every number in
# the duplicates commit was measured against this folder, which is why it is a
# folder on disk rather than a fixture. The pictures are other people's, for the
# same reason the styling screenshots are; and 520MB is not something to put in a
# history whose only way back out is a rewrite. A `git add -A` staged all of it
# once already, and the only thing that caught it was reading the file list.
test img set/

# Render evidence. The measurements beside them are the record — see the
# comment at app.py's REWRITE_OPS — and 87 MB of PNGs is not something a
# clone should pay for to read a number it can already read in a log.
tools/parse-eval-2026-08-17/**/*.png
tools/ab-krea-expansion/*.png

# Scratch that arrived during the parse evaluation and belongs to nobody.
session-export-*.zip
multi-subject-test-photos/
IMG_*.jpg
image-*.jpg
visionary-reduced.png

# Saved web pages from surface audits — a person's working artefact, not source.
Visionary Surface Audit.html
Visionary Surface Audit_files/

# macOS auto-named screenshots dropped in the repo root while working. The docs
# screenshots have real names (generate.png, regional.png) and live in docs/, so
# anchoring to the root keeps those while ignoring the scratch ones.
/Screenshot*.png
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
web/dist-ds/
.design-sync/upload-manifest.txt

# Upstream clones, read rather than built against — MiniMax-H3 for the prompt
# guides `_compile_h3_scene` is checked against, ai-toolkit for the trainer
# recipe Phase 5 needs. Both have their own remotes, so committing them would
# nest a repo inside this one and cost a clone 334MB to read two documents.
# The facts taken out of them live in CLAUDE.md and tools/vendor/.
MiniMax-H3/
ai-toolkit/

# Papers. 63MB of other people's PDFs, ignored for the reason the styling
# screenshots are — the synthesis beside them is the part that informed
# anything, and that is a 28K markdown file which is committed.
research/*.pdf

# Film. Enter the Void's death scene is the reference the blocking derivation
# was measured against and every number it produced is in the history; the
# clip itself is somebody's film and 20MB besides.
*.mp4
*.webp
A0000268.jpg
void.jpg
