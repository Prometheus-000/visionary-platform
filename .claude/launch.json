{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "preview-ui",
      "runtimeExecutable": "/opt/homebrew/bin/python3.11",
      "runtimeArgs": ["tools/preview_ui.py"],
      "autoPort": true,
      "port": 8791
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 5173
    },
    {
      "name": "storyline",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web", "--", "--port", "5199", "--strictPort"],
      "port": 5199
    }
  ]
}
